root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 4
continuation_indent_size = 8

[*.kts]
indent_style = tab

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

[*.properties]
indent_style = space
indent_size = 2
